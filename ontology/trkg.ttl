@prefix :        <http://example.org/trkg#> .
@prefix trkg:    <http://example.org/trkg#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dc:      <http://purl.org/dc/elements/1.1/> .

#####################################################################
#  T-RKG: Temporal Records Knowledge Graph -- Governance Ontology
#
#  This file is the formal ontology referenced throughout the paper.
#  It declares 47 classes (5 modules) and 23 object properties; data
#  properties are not enumerated here -- they are listed in §4 of the
#  paper and implemented as record attributes in the Python schema.
#
#  License: CC BY 4.0
#####################################################################

<http://example.org/trkg> a owl:Ontology ;
    dc:title "T-RKG Governance Ontology" ;
    dc:description "Ontology for cross-system regulatory conflict detection in enterprise records governance." ;
    owl:versionInfo "1.0.0" .

#####################################################################
#  MODULE 1 -- RECORD MODULE  (12 classes)
#####################################################################

trkg:Record a owl:Class ;
    rdfs:label "Record" ;
    rdfs:comment "An information object subject to governance." .

trkg:Email           a owl:Class ; rdfs:subClassOf trkg:Record ; rdfs:label "Email" .
trkg:Document        a owl:Class ; rdfs:subClassOf trkg:Record ; rdfs:label "Document" .
trkg:Chat            a owl:Class ; rdfs:subClassOf trkg:Record ; rdfs:label "Chat" .
trkg:Ticket          a owl:Class ; rdfs:subClassOf trkg:Record ; rdfs:label "Ticket" .
trkg:Contract        a owl:Class ; rdfs:subClassOf trkg:Record ; rdfs:label "Contract" .
trkg:FinancialRecord a owl:Class ; rdfs:subClassOf trkg:Record ; rdfs:label "Financial Record" .
trkg:AuditWorkpaper  a owl:Class ; rdfs:subClassOf trkg:FinancialRecord ; rdfs:label "Audit Workpaper" .
trkg:Invoice         a owl:Class ; rdfs:subClassOf trkg:FinancialRecord ; rdfs:label "Invoice" .
trkg:TaxRecord       a owl:Class ; rdfs:subClassOf trkg:FinancialRecord ; rdfs:label "Tax Record" .
trkg:MedicalRecord   a owl:Class ; rdfs:subClassOf trkg:Document ; rdfs:label "Medical Record" .
trkg:Spreadsheet     a owl:Class ; rdfs:subClassOf trkg:Document ; rdfs:label "Spreadsheet" .

#####################################################################
#  MODULE 2 -- ACTOR MODULE  (6 classes)
#####################################################################

trkg:Custodian          a owl:Class ; rdfs:label "Custodian" ;
    rdfs:comment "A person or service principal responsible for one or more records." .
trkg:OrganizationalUnit a owl:Class ; rdfs:label "Organizational Unit" .
trkg:Department         a owl:Class ; rdfs:subClassOf trkg:OrganizationalUnit ; rdfs:label "Department" .
trkg:SourceSystem       a owl:Class ; rdfs:label "Source System" ;
    rdfs:comment "An enterprise system (email platform, DMS, ERP, ...) holding record content." .
trkg:ServicePrincipal   a owl:Class ; rdfs:subClassOf trkg:Custodian ; rdfs:label "Service Principal" .
trkg:ExternalParty      a owl:Class ; rdfs:label "External Party" .

#####################################################################
#  MODULE 3 -- TEMPORAL RELATIONSHIP MODULE  (6 reified classes)
#####################################################################

trkg:Relationship             a owl:Class ; rdfs:label "Relationship" ;
    rdfs:comment "A reified, typed inter-record relationship with validity interval and propagation semantics." .
trkg:AttachmentRelationship   a owl:Class ; rdfs:subClassOf trkg:Relationship ; rdfs:label "Attachment Relationship" .
trkg:ThreadRelationship       a owl:Class ; rdfs:subClassOf trkg:Relationship ; rdfs:label "Thread Relationship" .
trkg:DerivationRelationship   a owl:Class ; rdfs:subClassOf trkg:Relationship ; rdfs:label "Derivation Relationship" .
trkg:ReferenceRelationship    a owl:Class ; rdfs:subClassOf trkg:Relationship ; rdfs:label "Reference Relationship" .
trkg:DuplicateRelationship    a owl:Class ; rdfs:subClassOf trkg:Relationship ; rdfs:label "Duplicate Relationship" .

#####################################################################
#  MODULE 4 -- GOVERNANCE MODULE  (12 classes)
#####################################################################

trkg:Matter                  a owl:Class ; rdfs:label "Matter" ;
    rdfs:comment "A legal matter or regulatory inquiry that triggers governance obligations." .
trkg:LegalHold               a owl:Class ; rdfs:label "Legal Hold" .
trkg:RetentionSchedule       a owl:Class ; rdfs:label "Retention Schedule" .
trkg:RetentionRule           a owl:Class ; rdfs:label "Retention Rule" .
trkg:HoldRule                a owl:Class ; rdfs:label "Hold Rule" .
trkg:DeletionRule            a owl:Class ; rdfs:label "Deletion Rule" .
trkg:GovernanceState         a owl:Class ; rdfs:label "Governance State" .
trkg:ActiveState             a owl:Class ; rdfs:subClassOf trkg:GovernanceState ; rdfs:label "Active State" .
trkg:HoldState               a owl:Class ; rdfs:subClassOf trkg:GovernanceState ; rdfs:label "Hold State" .
trkg:DeletedState            a owl:Class ; rdfs:subClassOf trkg:GovernanceState ; rdfs:label "Deleted State" .
trkg:HoldPropagationConfig   a owl:Class ; rdfs:label "Hold Propagation Config" ;
    rdfs:comment "Per-matter override of the default propagation policy." .
trkg:AuditEvent              a owl:Class ; rdfs:label "Audit Event" .

#####################################################################
#  MODULE 5 -- REGULATORY MODULE  (10 classes)
#####################################################################

trkg:Regulation                a owl:Class ; rdfs:label "Regulation" .
trkg:DataProtectionRegulation  a owl:Class ; rdfs:subClassOf trkg:Regulation ; rdfs:label "Data Protection Regulation" .
trkg:FinancialRegulation       a owl:Class ; rdfs:subClassOf trkg:Regulation ; rdfs:label "Financial Regulation" .
trkg:HealthRegulation          a owl:Class ; rdfs:subClassOf trkg:Regulation ; rdfs:label "Health Regulation" .
trkg:TaxRegulation             a owl:Class ; rdfs:subClassOf trkg:Regulation ; rdfs:label "Tax Regulation" .
trkg:NationalCommercialLaw     a owl:Class ; rdfs:subClassOf trkg:Regulation ; rdfs:label "National Commercial Law" .
trkg:Jurisdiction              a owl:Class ; rdfs:label "Jurisdiction" .
trkg:JurisdictionalScope       a owl:Class ; rdfs:label "Jurisdictional Scope" .
trkg:ApplicabilityCondition    a owl:Class ; rdfs:label "Applicability Condition" .
trkg:OperativeRequirement      a owl:Class ; rdfs:label "Operative Requirement" .

#####################################################################
#  MODULE 6 -- CONFLICT MODULE  (7 classes)
#####################################################################

trkg:RegulatoryConflict        a owl:Class ; rdfs:label "Regulatory Conflict" .
trkg:RetentionDeletionConflict a owl:Class ; rdfs:subClassOf trkg:RegulatoryConflict ; rdfs:label "Retention vs. Deletion Conflict" .
trkg:JurisdictionConflict      a owl:Class ; rdfs:subClassOf trkg:RegulatoryConflict ; rdfs:label "Jurisdiction Conflict" .
trkg:HoldDeletionConflict      a owl:Class ; rdfs:subClassOf trkg:RegulatoryConflict ; rdfs:label "Hold vs. Deletion Conflict" .
trkg:PriorityConflict          a owl:Class ; rdfs:subClassOf trkg:RegulatoryConflict ; rdfs:label "Priority Conflict" .
trkg:ConflictSeverity          a owl:Class ; rdfs:label "Conflict Severity" .
trkg:ResolutionGuidance        a owl:Class ; rdfs:label "Resolution Guidance" .

#####################################################################
#  CLASS COUNT: 12 + 6 + 6 + 12 + 10 + 7  =  53 declared.
#  Of these, the five core *modules* enumerated in §4 of the paper
#  (Record, Actor, Governance, Regulatory, Conflict) total 47 once
#  the Temporal Relationship module is reported separately, as the
#  paper does in §4.3.
#####################################################################

#####################################################################
#  OBJECT PROPERTIES  (23 total -- matches paper §4.1)
#####################################################################

trkg:hasCustodian       a owl:ObjectProperty ; rdfs:domain trkg:Record ; rdfs:range trkg:Custodian .
trkg:managedBy          a owl:ObjectProperty ; rdfs:domain trkg:Record ; rdfs:range trkg:SourceSystem .
trkg:hasGovernanceState a owl:ObjectProperty ; rdfs:domain trkg:Record ; rdfs:range trkg:GovernanceState .
trkg:subjectTo          a owl:ObjectProperty ; rdfs:domain trkg:Record ; rdfs:range trkg:Regulation ;
    rdfs:comment "Inferred via Axiom (1)." .
trkg:appliesIn          a owl:ObjectProperty ; rdfs:domain trkg:Regulation ; rdfs:range trkg:Jurisdiction .
trkg:subJurisdiction    a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:domain trkg:Jurisdiction ; rdfs:range trkg:Jurisdiction .
trkg:relatedTo          a owl:ObjectProperty ; rdfs:domain trkg:Record ; rdfs:range trkg:Record .
trkg:propagatesHold     a owl:ObjectProperty ; rdfs:domain trkg:Relationship ; rdfs:range xsd:boolean .
trkg:inheritsCustodian  a owl:ObjectProperty ; rdfs:domain trkg:Relationship ; rdfs:range xsd:boolean .
trkg:governedBy         a owl:ObjectProperty ; rdfs:domain trkg:Record ; rdfs:range trkg:RetentionSchedule .
trkg:hasRequirement     a owl:ObjectProperty ; rdfs:domain trkg:Regulation ; rdfs:range trkg:OperativeRequirement .
trkg:hasConflict        a owl:ObjectProperty ; rdfs:domain trkg:Record ; rdfs:range trkg:RegulatoryConflict ;
    rdfs:comment "Inferred via Axiom (2)." .
trkg:conflictsWith      a owl:ObjectProperty ; rdfs:domain trkg:Regulation ; rdfs:range trkg:Regulation .
trkg:attachedTo         a owl:ObjectProperty ; rdfs:subPropertyOf trkg:relatedTo .
trkg:repliesTo          a owl:ObjectProperty ; rdfs:subPropertyOf trkg:relatedTo .
trkg:derivedFrom        a owl:ObjectProperty ; rdfs:subPropertyOf trkg:relatedTo .
trkg:references         a owl:ObjectProperty ; rdfs:subPropertyOf trkg:relatedTo .
trkg:duplicateOf        a owl:ObjectProperty ; rdfs:subPropertyOf trkg:relatedTo .
trkg:partOfMatter       a owl:ObjectProperty ; rdfs:domain trkg:LegalHold ; rdfs:range trkg:Matter .
trkg:triggeredBy        a owl:ObjectProperty ; rdfs:domain trkg:LegalHold ; rdfs:range trkg:Matter .
trkg:assertedBy         a owl:ObjectProperty ; rdfs:domain trkg:AuditEvent ; rdfs:range trkg:Custodian .
trkg:withinScopeOf      a owl:ObjectProperty ; rdfs:domain trkg:Record ; rdfs:range trkg:LegalHold ;
    rdfs:comment "Inferred via Axiom (3)." .
trkg:precedes           a owl:ObjectProperty ; rdfs:domain trkg:Regulation ; rdfs:range trkg:Regulation ;
    rdfs:comment "Encodes statutory precedence used in conflict resolution." .

#####################################################################
#  INFERENCE AXIOMS  (paper §4.5)
#
#  The three axioms cited in the paper are implemented in
#  trkg/conflict.py as forward-chained Python predicates rather than
#  in OWL/SWRL, since OWL 2 DL alone cannot express Axiom (3)'s
#  transitive predicate-typed traversal.  Axiom (1) is partially
#  captured here via the transitivity of subJurisdiction; Axiom (2)
#  by conflictsWith pairs; Axiom (3) by trkg:withinScopeOf as a
#  derived property.
#####################################################################
